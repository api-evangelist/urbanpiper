  "info": {
    "_postman_id": "bfac517a-dee0-4d4d-80d6-a4dd89271500",
    "name": "UrbanPiper POS Integration Aggregator Menu API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "UrbanPiper's POS-integration REST API connects a restaurant POS/ERP to online ordering aggregators (Swiggy, Zomato, UberEats, DoorDash, Deliveroo, Talabat, Amazon, Careem and others). It covers store/location management, catalogue and menu push, store and item/option availability toggles, order status updates and webhook registration. Authentication is a static API key passed as `Authorization: apikey <api_username>:<api_key>`; multi-brand requests also pass the `X-UPR-Biz-Id` header.\n\nContact Support:\n Name: UrbanPiper POS Support\n Email: pos.support@urbanpiper.com",
      "type": "text/plain"
    }
  }
