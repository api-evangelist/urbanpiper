          "name": "Add or update menu (catalogue push)",
          "request": {
            "name": "Add or update menu (catalogue push)",
            "description": {
              "content": "Push the catalogue (categories, items, option groups, options, taxes, charges) for a brand. Use a location_ref_id of -1 to update at the master catalogue level. Flush flags reset previously available catalogue objects.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "external",
                "api",
                "v1",
                "inventory",
                "locations",
                ":location_ref_id",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "location_ref_id",
                  "description": "(Required) Store reference ID in the POS/ERP system. Pass -1 to update the master catalogue level only."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flush_categories\": \"<boolean>\",\n  \"flush_items\": \"<boolean>\",\n  \"flush_options\": \"<boolean>\",\n  \"flush_option_groups\": \"<boolean>\",\n  \"categories\": [\n    {\n      \"ref_id\": \"<string>\",\n      \"name\": \"<string>\",\n      \"sort_order\": \"<integer>\",\n      \"active\": \"<boolean>\"\n    },\n    {\n      \"ref_id\": \"<string>\",\n      \"name\": \"<string>\",\n      \"sort_order\": \"<integer>\",\n      \"active\": \"<boolean>\"\n    }\n  ],\n  \"items\": [\n    {\n      \"ref_id\": \"<string>\",\n      \"name\": \"<string>\",\n      \"price\": \"<number>\",\n      \"sort_order\": \"<integer>\",\n      \"recommended\": \"<boolean>\",\n      \"available\": \"<boolean>\"\n    },\n    {\n      \"ref_id\": \"<string>\",\n      \"name\": \"<string>\",\n      \"price\": \"<number>\",\n      \"sort_order\": \"<integer>\",\n      \"recommended\": \"<boolean>\",\n      \"available\": \"<boolean>\"\n    }\n  ],\n  \"option_groups\": [\n    \"<object>\",\n    \"<object>\"\n  ],\n  \"options\": [\n    \"<object>\",\n    \"<object>\"\n  ],\n  \"taxes\": [\n    \"<object>\",\n    \"<object>\"\n  ],\n  \"charges\": [\n    \"<object>\",\n    \"<object>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
