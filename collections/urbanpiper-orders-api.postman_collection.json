          "name": "Update order status",
          "request": {
            "name": "Update order status",
            "description": {
              "content": "Update the status of a relayed order. Expected statuses are Acknowledged, Food Ready, Dispatched, Completed and Cancelled. For self/merchant-delivered orders, rider_name and rider_phone are passed when marking the order as Dispatched.",
              "type": "text/plain"
            },
            "url": {
